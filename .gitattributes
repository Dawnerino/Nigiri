# Normalize line endings: text files use LF in the repo, scripts get LF so the
# .sh entrypoint is runnable on Unix straight after a Windows clone.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.bat  text eol=crlf

# Binary assets (if any ever get committed)
*.bin  binary
*.gguf binary
*.onnx binary
*.so   binary
*.dll  binary
*.dylib binary
*.exe  binary
